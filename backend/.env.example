# ===========================================
# BOQ COST DATABASE - ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your values

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=boq_system
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis Configuration (for exact match cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=true

# Security
SECRET_KEY=your-secret-key-change-this-in-production-use-64-chars-minimum
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Environment: development, staging, production
ENVIRONMENT=development

# ===========================================
# AI/ML Configuration
# ===========================================

# Google Gemini API (for AI classification)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-pro

# SBERT Model (for semantic matching)
SBERT_MODEL_NAME=keepitreal/vietnamese-sbert
SBERT_CACHE_DIR=./models/cache

# FAISS Index Configuration
FAISS_INDEX_PATH=./data/faiss_index
FAISS_NPROBE=10

# ===========================================
# Matching Thresholds
# ===========================================
EXACT_MATCH_THRESHOLD=0.95
FUZZY_MATCH_THRESHOLD=0.80
SEMANTIC_MATCH_THRESHOLD=0.85

# ===========================================
# Gatekeeper Quality Thresholds
# ===========================================
QUALITY_AUTO_APPROVE_THRESHOLD=75
QUALITY_PENDING_THRESHOLD=50

# ===========================================
# File Upload Configuration
# ===========================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=xlsx,xls,csv

# ===========================================
# Celery Configuration (async tasks)
# ===========================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===========================================
# Logging Configuration
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ===========================================
# CORS Configuration
# ===========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===========================================
# Production Settings (set in production only)
# ===========================================
# WORKERS=4
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
